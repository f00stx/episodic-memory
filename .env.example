# episodic-memory Docker configuration
# Copy this file to .env and fill in your values.

# Required: path to the directory containing episodes.db + hot_metadata.json
STORE_PATH=/path/to/your/memory/store

# Optional: override the default embedding model.
# bge-small (default) is 133MB and loads in ~5s.
# bge-large is 1.3GB and loads in ~30s but has slightly higher recall quality.
# EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Optional: minimum cosine similarity to return a result (default: 0.55)
# RECALL_THRESHOLD=0.55

# Optional: set to false to include roleplay/fiction in factual recall (default: true)
# FILTER_ROLEPLAY=true

# Optional: host port to expose the service on (default: 8099)
# PORT=8099

# Optional: path to a pre-downloaded HuggingFace cache directory.
# If unset, the model downloads on first start (requires internet access).
# MODEL_CACHE_PATH=~/.cache/huggingface/hub
